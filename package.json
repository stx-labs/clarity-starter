{
  "name": "clarity-starter-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "This repository is a base template to kick-start any Clarity project and build Smart Contracts on Bitcoin. You can use it as template to create your own project.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run -- --costs",
    "test:reports": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"vitest run -- --costs\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stacks/clarinet-sdk": "4.0.0",
    "@stacks/transactions": "7.6.0",
    "chokidar-cli": "3.0.0",
    "vitest": "5.0.5",
    "vitest-environment-clarinet": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  }
}
